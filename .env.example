# Docker Compose — copie este arquivo para .env na raiz do projeto.
# Todos os valores abaixo são os DEFAULTS da aplicação: o sistema já funciona
# sem o .env. Altere somente o que precisar (ex.: portas ocupadas na máquina).
# Exemplo: copy .env.example .env  (Windows)

# PostgreSQL (serviço "db" do docker-compose)
DB_NAME=radar_skill
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Backend Spring Boot (serviço "backend" do docker-compose)
BACKEND_PORT=8080

# Frontend Web (serviço "frontend" do docker-compose)
FRONTEND_PORT=8081

# JWT (backend)
JWT_SECRET=radar-skill-dev-secret-chave-jwt-hs256-2026-32bytes
JWT_EXPIRATION=86400000

# CORS (backend)
APP_CORS_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:3000
