# Copie este arquivo para .env e preencha com seus valores.

# PostgreSQL - aplicação
DB_HOST=localhost
DB_PORT=5432
DB_NAME=radar_skill
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Porta HTTP do Spring Boot (default: 8080)
SERVER_PORT=8080

# JWT
# Comando para gerar o JWT_SECRET = openssl rand -base64 32
JWT_SECRET=<seu-secreto-com-pelo-menos-32-caracteres>
JWT_EXPIRATION=86400000

# CORS
# Origem de dev deve corresponder ao FRONTEND_DEV_PORT do frontend/.env (default http://localhost:5173).
# Se a porta do dev server do Vite for alterada, atualize a origem aqui também.
APP_CORS_ORIGINS=http://localhost:5173

# Testes do backend (backend/src/test)
DB_TEST_HOST=localhost
DB_TEST_PORT=5432
DB_TEST_NAME=radar_skill_test
DB_TEST_USERNAME=postgres
DB_TEST_PASSWORD=postgres
JWT_TEST_SECRET=talentario-test-secret-jwt-hs256-2026-32bytes
