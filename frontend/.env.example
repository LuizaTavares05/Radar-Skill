# Configuração obrigatória : URL base da API (onde o backend está em execução).
#   - Backend manual (mvn): porta SERVER_PORT do backend/.env (default 8080)
#   - http://localhost:SERVER_PORT (precisa ser igual a porta onde esta rodando o mvn do backend)

VITE_API_BASE_URL=http://localhost:8080

# Porta do dev server do Vite (default: 5173). Altere apenas em caso de conflito
# de porta na máquina. IMPORTANTE: ao alterar, adicione http://localhost:<nova-porta>
# em APP_CORS_ORIGINS no backend/.env (as chamadas cross-origin do navegador dependem disso).
FRONTEND_DEV_PORT=5173
