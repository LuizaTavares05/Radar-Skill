# Copie para .env e ajuste para o IP da sua máquina na rede local.

# Descubra o IP: ipconfig (Windows) / ip addr (Linux/macOS)

# Funciona com o backend em QUALQUER dos dois modos (porta default 8080 nos dois):
#   - Manual (mvn): porta SERVER_PORT do backend/.env (default 8080)
#   - Docker:       porta BACKEND_PORT do .env da raiz (default 8080)
# Se alguma dessas portas for alterada, reflita o valor aqui.

EXPO_PUBLIC_API_URL=http://192.168.X.X:8080
